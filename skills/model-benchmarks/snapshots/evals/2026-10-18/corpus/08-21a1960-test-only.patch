 test("token gate: non-health calls need the bearer token", async ({ playwright }) => {
 	// Fresh context without the config's extraHTTPHeaders — proves the 401.
-	const bare = await playwright.request.newContext({ baseURL: API });
+	// NOTE: contexts created via the `playwright` fixture inherit `use`
+	// options, so extraHTTPHeaders must be cleared explicitly; otherwise the
+	// bearer token leaks in and the gate is never actually exercised.
+	const bare = await playwright.request.newContext({ baseURL: API, extraHTTPHeaders: {} });
 	try {
