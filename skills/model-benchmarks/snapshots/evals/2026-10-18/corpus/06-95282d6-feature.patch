+	function csvCell(v: string | number): string {
+		const s = String(v ?? "");
+		return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+	}
+
+	/** Re-encode extracted rows as importer-readable CSV so the existing
+	 * preview/override/duplicate/import flow is reused verbatim. */
+	function statementRowsToCsv(txs: NormalizedPreview["transactions"]): string {
+		const head = "Date,Description,Amount,Transaction Type,Category,Account Name,Notes";
+		const lines = txs.map((t) =>
+			[
+				t.date,
+				t.description,
+				String(t.amount),
+				t.transaction_type,
+				t.category,
+				t.account_name,
+				t.notes ?? "",
+			]
+				.map(csvCell)
+				.join(","),
+		);
+		return [head, ...lines].join("\n");
+	}
+
+	async function onPdfFile(e: Event) {
+		const input = e.target as HTMLInputElement;
+		const file = input.files?.[0];
+		input.value = "";
+		if (!file) return;
+		if (isWeb) {
+			toast.error(WEB_NO_BACKEND_MSG);
+			return;
+		}
+		if (file.size > 15 * 1024 * 1024) {
+			toast.error("That PDF is over 15 MB — split the statement and retry.");
+			return;
+		}
+		pdfBusy = true;
+		stmtBusy = false;
+		pdfInfo = null;
+		try {
+			const dataUrl = await new Promise<string>((resolve, reject) => {
+				const r = new FileReader();
+				r.onload = () => resolve(String(r.result ?? ""));
+				r.onerror = () => reject(new Error("Could not read that file"));
+				r.readAsDataURL(file);
+			});
+			const pdfBase64 = (dataUrl.split(",", 2)[1] ?? "").trim();
+			if (!pdfBase64) throw new Error("Could not read that file");
+			const md = await api.pdfToMarkdown(pdfBase64, file.name);
+			pdfBusy = false;
+			stmtBusy = true;
+			const accountName = file.name.replace(/\.pdf$/i, "").slice(0, 60) || "Imported";
+			const extracted = await api.extractStatement(md.markdown, accountName);
+			if (!extracted.transactions.length) {
+				pdfInfo =
+					extracted.llm_used === false
+						? "Local AI is unavailable, so no rows could be extracted. Start Ollama and retry."
+						: "No transactions found in that PDF — check it is a text statement, not a scan.";
+				preview = null;
+				rawCsv = "";
+				toast.error(pdfInfo);
+				return;
+			}
+			previewAi = {};
+			previewCatOverrides = {};
+			preview = extracted;
+			rawCsv = statementRowsToCsv(extracted.transactions);
+			pdfInfo =
+				`${file.name}: ${md.pages} page${md.pages === 1 ? "" : "s"}` +
+				`${md.truncated ? " (long statement, read first 120k chars)" : ""} → ` +
+				`${extracted.transactions.length} rows` +
+				`${extracted.llm_used === false ? " (rules fallback — verify categories)" : " (AI extracted — verify below)"}`;
+			toast.ok(`PDF ready — ${extracted.transactions.length} rows to verify`);
+		} catch (err) {
+			toast.error(errMsg(err));
+		} finally {
+			pdfBusy = false;
+			stmtBusy = false;
+		}
+	}
+
 	async function doImport() {
 		if (!rawCsv || !preview) return;
 		importBusy = true;
