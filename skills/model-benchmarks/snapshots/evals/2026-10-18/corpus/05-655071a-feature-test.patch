+
+test("PDF statement commands validate input without needing Ollama or PyMuPDF", async ({
+	request,
+}) => {
+	// Empty PDF bytes are rejected before any Python runs.
+	const empty = await request.post(`${API}/api/pdf_statement_to_markdown`, {
+		data: { pdfBase64: "   ", filename: "mock.pdf" },
+	});
+	expect(empty.status()).toBe(500);
+	expect((await empty.json()).error).toMatch(/pdf data/i);
+	// Empty markdown short-circuits to an empty preview (no model call).
+	const preview = await (
+		await request.post(`${API}/api/pdf_statement_extract`, {
+			data: { markdown: "  ", defaultAccount: "Imported" },
+		})
+	).json();
+	expect(preview).toMatchObject({
+		transactions: [],
+		detected_format: "pdf-statement",
+		skipped: 0,
+		llm_used: false,
+	});
+});
