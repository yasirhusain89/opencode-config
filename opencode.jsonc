{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.8:latest": {
          "name": "Qwen 3.8 (local)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "permission": {
    "edit": {
      "*": "allow",
      "**/.env*": "deny",
      "**/*token*": "deny",
      "**/*.keystore": "deny",
      "**/*.jks": "deny",
      "**/*.mobileprovision": "deny",
      "**/google-services.json": "deny",
      "**/GoogleService-Info.plist": "deny"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*token*": "ask",
      "**/*.keystore": "deny",
      "**/*.jks": "deny",
      "**/monartha.db*": "ask",
      "**/myfinances.db*": "ask"
    },
    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf *": "ask",
      "rm -r *": "ask",
      "sudo *": "deny",
      "su *": "deny",
      "chown *": "deny",
      "chmod -R *": "ask",
      "mkfs *": "deny",
      "dd *": "deny",
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git reset --hard*": "ask",
      "git clean -fd*": "ask",
      "git push*": "ask",
      "git commit*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "gh pr merge*": "ask",
      "gh release delete*": "ask",
      "gh api *DELETE*": "ask",
      "gh variable delete*": "ask",
      "gh variable set*": "ask",
      "cargo publish*": "ask",
      "npm publish*": "ask",
      "curl *|*sh*": "deny",
      "wget *|*sh*": "deny",
      "curl *": "ask",
      "wget *": "ask"
    },
    "external_directory": {
      "~/PycharmProjects/monartha/**": "allow",
      "~/PycharmProjects/opencode-config/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/Library/Keychains/**": "deny",
      "*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "skill": "allow"
  },
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/gitnexus",
        "mcp"
      ],
      "timeout": 600000
    },
    "zvec_grep": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/zg",
        "server",
        "--stdio"
      ],
      "enabled": true,
      "timeout": 600000
    }
  }
}