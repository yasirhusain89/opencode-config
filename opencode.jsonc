{
  "$schema": "https://opencode.ai/config.json",
  // Primary: Go plan spark-1.3-contributor (Intel 48 at ~$0.10-0.15/task
  // contributor-adjusted — best Intel-per-dollar in the plan; p50 ~4.6s).
  // Training trade ACCEPTED 2026-10-21: this route trains Meta (not ZDR,
  // Meta region-limited). Requires the Go key: /connect → OpenCode Go.
  // Availability-only switch on model-specific 429 (Go quota is account-wide):
  //   TUI: /models → opencode-go/glm-5.3-flash (zero-retention, ~5x cost)
  //   CLI: OPENCODE_CONFIG_CONTENT='{"model":"opencode-go/glm-5.3-flash","agents":{"title":{"model":"opencode-go/glm-5.3-flash"}}}' opencode run --title "backup" "..."
  // Free approved low-stakes backup: nvidia/z-ai/glm-5.3-flash.
  // model-fallback.js arms the next prompt; it cannot replace in-flight retries.
  // title/summary calls (agents.title.model) must ride along: title/summary calls hit the same quota.
  // Last resort (offline, no quota): ollama/qwen3.8:latest — needs
  // "compaction":{"auto":false} added to the override JSON (it rambles summaries).
  "model": "opencode-go/muse-spark-1.3-contributor",
  "agents": {
    "general": {
      "model": "opencode-go/muse-spark-1.3-contributor"
    },
    "explore": {
      "model": "opencode-go/glm-5.3-flash",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "plan": {
      "permissions": [
        // Agent overrides come after global allows. Restore the built-in
        // plan-file exceptions for worktree-relative and absolute tool paths.
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/plans/*.md", "effect": "allow" },
        { "action": "edit", "resource": "**/.opencode/plans/*.md", "effect": "allow" },
        { "action": "edit", "resource": "**/.local/share/opencode/plans/*.md", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "deny" },
        { "action": "external_directory", "resource": "~/.local/share/opencode/plans", "effect": "allow" },
        { "action": "external_directory", "resource": "~/.local/share/opencode/plans/**", "effect": "allow" }
      ]
    },
    "title": {
      "model": "opencode-go/muse-spark-1.3-contributor"
    }
  },
  "providers": {
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.8:latest": {
          "name": "Qwen 3.8 (local, quota backup)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            // Keep modest: opencode passes this as num_ctx. 262k on a 27B
            // local model reloads ~19GB+ KV cache and stalls startup.
            "context": 32768,
            "output": 16384
          }
        }
      }
    }
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "**/.env*", "effect": "deny" },
    { "action": "edit", "resource": "**/access_token", "effect": "deny" },
    { "action": "edit", "resource": "**/token.json", "effect": "deny" },
    { "action": "edit", "resource": "**/credentials.json", "effect": "deny" },
    { "action": "edit", "resource": "**/auth.json", "effect": "deny" },
    { "action": "edit", "resource": "**/.go-api-key", "effect": "deny" },
    { "action": "edit", "resource": "**/.npmrc", "effect": "deny" },
    { "action": "edit", "resource": "**/.netrc", "effect": "deny" },
    { "action": "edit", "resource": "**/id_rsa", "effect": "deny" },
    { "action": "edit", "resource": "**/id_ed25519", "effect": "deny" },
    { "action": "edit", "resource": "**/*.keystore", "effect": "deny" },
    { "action": "edit", "resource": "**/*.jks", "effect": "deny" },
    { "action": "edit", "resource": "**/*.mobileprovision", "effect": "deny" },
    { "action": "edit", "resource": "**/google-services.json", "effect": "deny" },
    { "action": "edit", "resource": "**/GoogleService-Info.plist", "effect": "deny" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/access_token", "effect": "deny" },
    { "action": "read", "resource": "**/token.json", "effect": "deny" },
    { "action": "read", "resource": "**/credentials.json", "effect": "deny" },
    { "action": "read", "resource": "**/auth.json", "effect": "deny" },
    { "action": "read", "resource": "**/.go-api-key", "effect": "deny" },
    { "action": "read", "resource": "**/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "**/.netrc", "effect": "deny" },
    { "action": "read", "resource": "**/id_rsa", "effect": "deny" },
    { "action": "read", "resource": "**/id_ed25519", "effect": "deny" },
    { "action": "read", "resource": "**/*.keystore", "effect": "deny" },
    { "action": "read", "resource": "**/*.jks", "effect": "deny" },
    { "action": "read", "resource": "**/monartha.db*", "effect": "allow" },
    { "action": "read", "resource": "**/myfinances.db*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf *", "effect": "allow" },
    { "action": "shell", "resource": "rm -r *", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~*", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "chown *", "effect": "deny" },
    { "action": "shell", "resource": "chmod -R *", "effect": "allow" },
    { "action": "shell", "resource": "mkfs *", "effect": "deny" },
    { "action": "shell", "resource": "dd *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "allow" },
    { "action": "shell", "resource": "git clean -fd*", "effect": "allow" },
    { "action": "shell", "resource": "git push*", "effect": "allow" },
    { "action": "shell", "resource": "git commit*", "effect": "allow" },
    { "action": "shell", "resource": "git merge*", "effect": "allow" },
    { "action": "shell", "resource": "git rebase*", "effect": "allow" },
    { "action": "shell", "resource": "git push --force*", "effect": "ask" },
    { "action": "shell", "resource": "git push * --force*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "ask" },
    { "action": "shell", "resource": "gh release delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh api *DELETE*", "effect": "ask" },
    { "action": "shell", "resource": "gh variable delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh variable set*", "effect": "ask" },
    { "action": "shell", "resource": "cargo publish*", "effect": "ask" },
    { "action": "shell", "resource": "npm publish*", "effect": "ask" },
    { "action": "shell", "resource": "curl *", "effect": "allow" },
    { "action": "shell", "resource": "wget *", "effect": "allow" },
    { "action": "shell", "resource": "curl *|*sh*", "effect": "deny" },
    { "action": "shell", "resource": "wget *|*sh*", "effect": "deny" },
    { "action": "shell", "resource": "*sleep [1][8-9][0-9]*", "effect": "deny" },
    { "action": "shell", "resource": "*sleep [2-9][0-9][0-9]*", "effect": "deny" },
    { "action": "shell", "resource": "*sleep [1-9][0-9][0-9][0-9]*", "effect": "deny" },
    { "action": "shell", "resource": "*nohup*", "effect": "deny" },
    { "action": "shell", "resource": "*setsid*", "effect": "deny" },
    { "action": "shell", "resource": "*disown*", "effect": "deny" },
    { "action": "shell", "resource": "*caffeinate*", "effect": "deny" },
    { "action": "shell", "resource": "*pkill*-9*", "effect": "deny" },
    { "action": "shell", "resource": "killall *", "effect": "deny" },
    { "action": "shell", "resource": "wine *", "effect": "ask" },
    { "action": "shell", "resource": "wine32 *", "effect": "ask" },
    { "action": "shell", "resource": "wine64 *", "effect": "ask" },
    { "action": "shell", "resource": "wineserver *", "effect": "ask" },
    { "action": "shell", "resource": "wineboot *", "effect": "ask" },
    { "action": "shell", "resource": "winetricks *", "effect": "ask" },
    { "action": "shell", "resource": "/Applications/*/Contents/Resources/wine/bin/*", "effect": "ask" },
    { "action": "shell", "resource": "\"/Applications/*/Contents/Resources/wine/bin/*", "effect": "ask" },
    { "action": "shell", "resource": "'/Applications/*/Contents/Resources/wine/bin/*", "effect": "ask" },
    { "action": "shell", "resource": "/Applications/*/Contents/MacOS/wine*", "effect": "ask" },
    { "action": "shell", "resource": "\"/Applications/*/Contents/MacOS/wine*", "effect": "ask" },
    { "action": "shell", "resource": "'/Applications/*/Contents/MacOS/wine*", "effect": "ask" },
    { "action": "shell", "resource": "/opt/*/bin/wine*", "effect": "ask" },
    { "action": "shell", "resource": "\"/opt/*/bin/wine*", "effect": "ask" },
    { "action": "shell", "resource": "'/opt/*/bin/wine*", "effect": "ask" },
    { "action": "shell", "resource": "/usr/local/bin/wine*", "effect": "ask" },
    { "action": "shell", "resource": "*OPENCODE_ALLOW_WINE=1*", "effect": "ask" },
    { "action": "shell", "resource": "*open*://*", "effect": "deny" },
    { "action": "shell", "resource": "*open*.app*", "effect": "deny" },
    { "action": "shell", "resource": "*open -a*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/projects", "effect": "allow" },
    { "action": "external_directory", "resource": "~/projects/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Projects", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Projects/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/PycharmProjects/monartha", "effect": "allow" },
    { "action": "external_directory", "resource": "~/PycharmProjects/monartha/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/PycharmProjects/opencode-config", "effect": "allow" },
    { "action": "external_directory", "resource": "~/PycharmProjects/opencode-config/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/folders/4g/6g1qk_3j4_30czm9c_r3wrlc0000gn/T/opencode", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/folders/4g/6g1qk_3j4_30czm9c_r3wrlc0000gn/T/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/folders/4g/6g1qk_3j4_30czm9c_r3wrlc0000gn/T/opencode", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/folders/4g/6g1qk_3j4_30czm9c_r3wrlc0000gn/T/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/tool-output", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/tool-output/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/log", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/log/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.ssh", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.aws", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.aws/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.gnupg", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.gnupg/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Library/Keychains", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Library/Keychains/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Documents", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Documents/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Downloads", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Downloads/**", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "gitnexus": {
        "type": "local",
        "command": [
          "/opt/homebrew/bin/gitnexus",
          "mcp"
        ],
        "timeout": {
          "startup": 600000,
          "catalog": 600000,
          "execution": 600000
        }
      }
    }
  }
}
