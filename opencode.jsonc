{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.8:latest": {
          "name": "Qwen 3.8 (local)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "rm -rf *": "ask",
      "sudo *": "ask",
      "curl *": "ask",
      "wget *": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/gitnexus",
        "mcp"
      ],
      "timeout": 600000
    },
    "zvec_grep": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/zg",
        "server",
        "--stdio"
      ],
      "enabled": true,
      "timeout": 600000
    }
  }
}